---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import { activeProfile, siteConfig } from "../site-config";

const profile = await getEntry("roleProfiles", activeProfile);
if (!profile) throw new Error(`Missing active role profile: ${activeProfile}`);

const allStudies = await getCollection("caseStudies", ({ data }) => data.featured);
const studies = profile.data.featuredCaseStudies
  .map((id) => allStudies.find((study) => study.id === id))
  .filter((study): study is (typeof allStudies)[number] => Boolean(study));

if (studies.length !== profile.data.featuredCaseStudies.length) {
  throw new Error(`The ${activeProfile} role profile references a missing case study.`);
}

const headlineParts = profile.data.headline.trim().split(" ");
const headlineAccent = headlineParts.pop();
const headlineLead = headlineParts.join(" ");

const principles = [
  {
    number: "01",
    title: "Listen for friction",
    body: "The interesting problem is usually hiding in a customer workaround, a system failure, or a metric that does not quite make sense.",
  },
  {
    number: "02",
    title: "Build the risky part",
    body: "I make the smallest real version that can expose whether the hard assumption is true—sometimes before there is even an interface.",
  },
  {
    number: "03",
    title: "Read reality",
    body: "I instrument behavior, stay with the data past the first exciting result, and let evidence change the plan.",
  },
  {
    number: "04",
    title: "Engineer momentum",
    body: "Once the signal is real, I turn it into clear direction, reliable systems, and a product the team can keep extending.",
  },
];

const builds = [
  {
    title: "Resume Score",
    type: "AI product · Shipped",
    body: "Led a cross-functional launch spanning machine learning, frontend, backend, and go-to-market.",
  },
  {
    title: "CoverLetterAI",
    type: "Growth experiment · Validated",
    body: "Validated demand with a tracked product affordance before committing the team to development.",
  },
  {
    title: "Referral loop",
    type: "Growth system · Built",
    body: "Built the product and backend logic for incentive-driven acquisition with minimal ongoing cost.",
  },
  {
    title: "Browser extension",
    type: "Workflow expansion · Prototyped",
    body: "Brought the product into the job-search workflow to remove context switching and manual input.",
  },
];

const career = [
  {
    years: "2017-2021",
    company: "Stellantis",
    role: "Engineering Co-op",
    description: "Used statistical analysis and systems modeling to challenge assumptions in vehicle development.",
  },
  {
    years: "2022-2023",
    company: "LightGuide",
    role: "Integration Engineer",
    description: "Connected augmented-reality software to real manufacturing workflows, people, and industrial systems.",
  },
  {
    years: "2023-2025",
    company: "JoyJobs.ai",
    role: "Technical Co-Founder & Head of Product",
    description: "Built, launched, monetized, and scaled applied-AI products from customer calls to production systems.",
  },
  {
    years: "2025-now",
    company: "Sensors, Inc.",
    role: "Product Growth Lead",
    description: "Bringing industrial instrumentation and edge-to-cloud products to market with customers and channel partners.",
  },
];
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="hero">
    <div class="hero-atmosphere" aria-hidden="true">
      <span class="aurora aurora-one"></span>
      <span class="aurora aurora-two"></span>
      <span class="aurora aurora-three"></span>
    </div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span class="live-dot"></span>{profile.data.eyebrow}</p>
        <h1>{headlineLead} <span class="gradient-text">{headlineAccent}</span></h1>
        <p class="hero-summary">{profile.data.summary}</p>
        <div class="hero-actions">
          <a class="button button-accent" href="#work">See how I build <span aria-hidden="true">↓</span></a>
          <a class="text-link light-link" href={siteConfig.linkedin} target="_blank" rel="noreferrer">
            Connect on LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <aside class="hero-portrait" aria-label="About Mason Campbell">
        <div class="signal-field" aria-hidden="true">
          <div class="fractal-ring ring-one"></div>
          <div class="fractal-ring ring-two"></div>
          <div class="fractal-ring ring-three"></div>
          <div class="fractal-ring ring-four"></div>
          <div class="prism-core"></div>
        </div>
        <div class="portrait-note glass-surface">
          <p class="signal-label">Current signal</p>
          <p>Building industrial products where hardware, cloud, and customer operations meet.</p>
          <div class="signal-meta">
            <span>Detroit, MI</span>
            <span>2026</span>
          </div>
        </div>
      </aside>
    </div>

    <div class="shell proof-grid" aria-label="Selected outcomes">
      {profile.data.proofPoints.map((point) => (
        <div class="proof-item">
          <strong>{point.value}</strong>
          <div>
            <span>{point.label}</span>
            {point.note && <small>{point.note}</small>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section work-section" id="work">
    <div class="shell">
      <header class="section-header split-header">
        <div>
          <p class="eyebrow">Selected work · Build / Grow / Scale</p>
          <h2>Products are decisions made visible.</h2>
        </div>
        <p>Three stories about finding the real constraint, getting close to the machinery, and moving from intuition to evidence.</p>
      </header>

      <div class="case-grid">
        {studies.map((study, index) => <CaseStudyCard study={study} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section approach-section" id="approach">
    <div class="shell">
      <header class="section-header">
        <p class="eyebrow">My operating system</p>
        <h2>Curious enough to wander.<br />Disciplined enough to measure.</h2>
      </header>

      <ol class="principle-grid">
        {principles.map((principle) => (
          <li>
            <span>{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </li>
        ))}
      </ol>

      <div class="operator-note">
        <p class="eyebrow">Where I do my best work</p>
        <blockquote>
          Give me the messy problem: incomplete evidence, technical constraints, and a customer need that matters. I will find a way to make it tangible—then make the case for what comes next.
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section builds-section" aria-labelledby="builds-title">
    <div class="shell">
      <header class="section-header split-header">
        <div>
          <p class="eyebrow">Built between the lines</p>
          <h2 id="builds-title">Momentum compounds.</h2>
        </div>
        <p>The small things are often the fastest route to truth. These launches and experiments created the next useful signal.</p>
      </header>

      <div class="build-grid">
        {builds.map((build, index) => (
          <article>
            <div class="build-card-meta">
              <span>0{index + 1}</span>
              <span>{build.type}</span>
            </div>
            <h3>{build.title}</h3>
            <p>{build.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section background-section" id="background">
    <div class="shell background-grid">
      <header class="section-header">
        <p class="eyebrow">The trajectory</p>
        <h2>Four chapters.<br />One instinct.</h2>
        <p class="background-intro">Cars, spatial computing, applied AI, industrial systems—the medium changed. The instinct stayed the same: understand how it works, then make it work better for people.</p>
      </header>

      <ol class="timeline">
        {career.map((item) => (
          <li>
            <p class="timeline-years">{item.years}</p>
            <div>
              <p class="timeline-role">{item.role}</p>
              <h3>{item.company}</h3>
              <p>{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section focus-section">
    <div class="shell focus-grid">
      <div>
        <p class="eyebrow">What I am reaching for next</p>
        <h2>Growth and AI products with real-world gravity.</h2>
      </div>
      <ul aria-label="Areas of focus">
        {profile.data.focusAreas.map((area) => <li>{area}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
