---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { activeProfile, siteConfig } from "../site-config";
import { selectedProjectIds, companyLogos } from "../data/projects";
import Arrow from "../components/Arrow.astro";
import ProjectCard from "../components/ProjectCard.astro";
const profile = await getEntry("roleProfiles", activeProfile);
if (!profile) throw new Error("Missing active role profile: " + activeProfile);
const allStudies = await getCollection("caseStudies");
const selected = selectedProjectIds.map(id => allStudies.find(study => study.id === id)!);
const chapters = profile.data.featuredCaseStudies.map(id => ({ study: allStudies.find(item => item.id === id)!, framing: profile.data.chapters?.find(item => item.id === id) }));
---
<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="hero shell home-frame">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{profile.data.eyebrow}</p>
        <h1>{profile.data.headline}</h1>
        <p class="hero-summary">{profile.data.summary}</p>
        <p class="hero-location">Based in Southeast Michigan · Open to relocation</p>
        <div class="hero-actions"><a class="button button-primary" href="#selected-work">View selected work <Arrow /></a><a class="text-link" href="/about/">More about me <Arrow /></a></div>
      </div>
      <aside class="hero-decision" aria-labelledby="decision-title">
        <p class="eyebrow">A decision behind the product</p>
        <div class="decision-brand"><img src="/company-logos/joyjobs.png" alt="JoyJobs.ai" width="160" height="35" /></div>
        <h2 id="decision-title">Tailored text still left users with manual work.</h2>
        <p>Early testers liked tailored resume text. They still had to copy it back into a document.</p>
        <div class="decision-insight"><span class="eyebrow">The product choice</span><p>Update the original document and preserve its formatting.</p></div>
        <a class="text-link" href="/stories/resume-ai/">See how the workflow changed <Arrow /></a>
      </aside>
    </div>
  </section>
  <section class="selected-section" id="selected-work">
    <div class="shell home-frame section-pad">
      <div class="section-heading"><div><p class="eyebrow">Selected work</p><h2>AI software, field tools,<br />and AR guidance.</h2></div><p>Three contexts where customer workflows shaped what I built and how I chose the next step.</p></div>
      <div class="project-grid">{selected.map(study => <ProjectCard study={study} />)}</div>
      <a class="text-link section-end-link" href="/work/">Explore all work <Arrow /></a>
    </div>
  </section>
  <section class="career-section" id="work">
    <div class="shell home-frame section-pad">
      <div class="section-heading"><div><p class="eyebrow">Experience</p><h2>How the skills connect.</h2></div><p>Analytical rigor, user research, building from 0 to 1, and product ownership across my career.</p></div>
      <div class="career-list">{chapters.map(({ study, framing }) => <article class="career-item" id={`chapter-${study.id}`}>
        <div class="career-company"><img src={companyLogos[study.id]} alt="" width="96" height="40" /><div><h3>{study.data.context.split(" · ")[0]}</h3><span>{study.data.timeframe}</span></div></div>
        <div><p class="career-skill">{framing?.skill}</p><p>{framing?.evidence}</p></div>
        <a class="text-link" href={`/stories/${study.id}/`} aria-label={`View ${study.data.context.split(" · ")[0]} project`}>View work <Arrow /></a>
      </article>)}</div>
    </div>
  </section>
</BaseLayout>
