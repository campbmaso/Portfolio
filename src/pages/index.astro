---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { activeProfile, siteConfig } from "../site-config";

const profile = await getEntry("roleProfiles", activeProfile);
if (!profile) throw new Error("Missing active role profile: " + activeProfile);

const allStudies = await getCollection("caseStudies");
const companyLogos: Record<string, string> = {
  "stellantis-analytical-foundation": "/company-logos/stellantis.svg",
  "lightguide-ar-workflows": "/company-logos/lightguide.png",
  "resume-ai": "/company-logos/joyjobs.png",
  "sensors-platform-strategy": "/company-logos/sensors.png",
};
const chapters = profile.data.featuredCaseStudies.map((id) => {
  const study = allStudies.find((item) => item.id === id);
  if (!study) throw new Error("The active role profile references a missing case study: " + id);
  return { study, framing: profile.data.chapters?.find((chapter) => chapter.id === id) };
});
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="hero">
    <div class="shell home-frame">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> {profile.data.eyebrow}</p>
          <h1>{profile.data.headline}</h1>
          <p class="hero-summary">{profile.data.summary}</p>
          <p class="hero-location">Based in Southeast Michigan · Open to relocation</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">Explore my experience <svg class="cta-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
            <a class="text-link" href="/stories/">See all stories <svg class="cta-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
          </div>
        </div>

        <aside class="skill-stack" aria-labelledby="stack-title">
          <div class="stack-heading">
            <p class="eyebrow">The skills behind the work</p>
            <span>01 — {String(chapters.length).padStart(2, "0")}</span>
          </div>
          <h2 id="stack-title">Built one<br />chapter at a time.</h2>
          <ol class="stack-list">
            {chapters.map(({ study, framing }, index) => (
              <li>
                <a href={"#chapter-" + study.id}>
                  <span class="stack-number">0{index + 1}</span>
                  <span class="stack-skill">{framing?.skill ?? study.data.eyebrow}</span>
                  <span class="stack-company">{study.data.context.split(" · ")[0]}</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="stack-footer"> Each experience adds a new perspective.</p>
        </aside>
      </div>
      <div class="hero-bottom"><span>PRODUCT · PEOPLE · SYSTEMS</span><span>SCROLL TO EXPLORE</span></div>
    </div>
  </section>

  <section class="career-section" id="work">
    <div class="shell home-frame">
      <div class="career-heading">
        <div>
          <p class="eyebrow">Experience <span class="section-count">· {String(chapters.length).padStart(2, "0")} CHAPTERS</span></p>
          <h2>A product mindset,<br />built over time.</h2>
        </div>
        <p>Each role added a new skill—from analytical problem-solving to understanding users, building software, and aligning teams.</p>
      </div>

      <div class="chapter-list">
        {chapters.map(({ study, framing }) => (
          <article class="chapter-row" id={"chapter-" + study.id}>
            <div class="chapter-meta">
              {companyLogos[study.id] && <span class="company-logo"><img src={companyLogos[study.id]} alt="" loading="lazy" decoding="async" /></span>}
              <div><h3>{study.data.context.split(" · ")[0]}</h3><span>{study.data.timeframe}</span></div>
            </div>
            <div class="chapter-main">
              <p class="chapter-skill">{framing?.skill ?? study.data.eyebrow}</p>
              <h4>{framing?.heading ?? study.data.title}</h4>
              <p>{framing?.narrative ?? study.data.summary}</p>
              <div class="chapter-tags">{study.data.capabilities.slice(0, 3).map((capability) => <span>{capability}</span>)}</div>
            </div>
            <div class="chapter-proof">
              <p class="proof-label"><svg class="proof-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.5c-2-1.5-4.5-2-7.5-1.5v12c3-.5 5.5 0 7.5 1.5m0-12c2-1.5 4.5-2 7.5-1.5v12c-3-.5-5.5 0-7.5 1.5m0-12v12" /></svg> In practice</p>
              <p>{framing?.evidence ?? study.data.outcome}</p>
              <a href={"/stories/" + study.id + "/"}>Read the story <svg class="cta-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
            </div>
          </article>
        ))}
      </div>

      <div class="stories-prompt">
        <div><p class="eyebrow">Go deeper</p><h2>The decisions behind the work.</h2></div>
        <a class="button button-secondary" href="/stories/">Explore all product stories <svg class="cta-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
      </div>
    </div>
  </section>
</BaseLayout>
