---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const studies = await getCollection("caseStudies");
  return studies.map((study) => ({
    params: { id: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<BaseLayout
  title={study.data.title}
  description={study.data.summary}
  canonicalPath={`/work/${study.id}/`}
  pageClass="case-page"
>
  <article>
    <header class="case-hero">
      <div class="shell case-hero-grid">
        <div>
          <a class="back-link" href="/#work"><span aria-hidden="true">←</span> Selected work</a>
          <p class="eyebrow">{study.data.eyebrow}</p>
          <h1>{study.data.title}</h1>
          <p class="case-deck">{study.data.summary}</p>
        </div>
        <dl class="case-facts">
          <div>
            <dt>Context</dt>
            <dd>{study.data.context}</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd>{study.data.role}</dd>
          </div>
          <div>
            <dt>Timeframe</dt>
            <dd>{study.data.timeframe}</dd>
          </div>
        </dl>
      </div>
    </header>

    <section class="case-metric-band" aria-label="Case study outcomes">
      <div class="shell metric-band-grid">
        {study.data.metrics.map((metric) => (
          <div>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
            {metric.note && <small>{metric.note}</small>}
          </div>
        ))}
      </div>
    </section>

    <div class="shell case-body-grid">
      <aside class="case-sidebar">
        <div>
          <p class="case-sidebar-label">The challenge</p>
          <p>{study.data.challenge}</p>
        </div>
        <div>
          <p class="case-sidebar-label">The outcome</p>
          <p>{study.data.outcome}</p>
        </div>
        <div>
          <p class="case-sidebar-label">Capabilities</p>
          <ul>
            {study.data.capabilities.map((capability) => <li>{capability}</li>)}
          </ul>
        </div>
      </aside>

      <div class="case-prose">
        <Content />

        <section class="evidence-box" aria-labelledby="evidence-title">
          <p class="eyebrow">Evidence used</p>
          <h2 id="evidence-title">What grounded the decision</h2>
          <ul>
            {study.data.evidence.map((item) => <li>{item}</li>)}
          </ul>
          <p class="evidence-note">Supporting detail is summarized at a public-safe level. Deeper artifacts can be discussed where confidentiality allows.</p>
        </section>
      </div>
    </div>

    <nav class="shell case-next" aria-label="Case study navigation">
      <p>Next: see how the work fits together.</p>
      <a class="button button-dark" href="/#approach">How I operate <span aria-hidden="true">→</span></a>
    </nav>
  </article>
</BaseLayout>
