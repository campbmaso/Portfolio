---
import { getCollection } from "astro:content";
import Arrow from "../components/Arrow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArtworkGallery from "../components/ArtworkGallery.astro";
const research = Object.fromEntries((await getCollection("research")).map(brief => [brief.id, brief.data]));
---

<BaseLayout title="About" description="Meet Mason Campbell, a product manager and technical co-founder based in Southeast Michigan and open to relocation.">
  <section class="about-hero">
    <div class="shell about-shell">
      <div class="intro-grid">
        <div>
          <h1>Engineering roots.<br />Product ownership.</h1>
          <p class="intro-lead">I’m Mason, a product manager and technical co-founder based in Southeast Michigan and open to relocation. My work spans AI software, augmented reality guidance, and measurement tools.</p>
        </div>
        <div class="portrait-wrap">
          <img src="/mason-campbell.jpg" alt="Mason Campbell" width="400" height="400" />
          <div class="portrait-caption"><strong>Southeast Michigan</strong><span>· Open to relocation</span></div>
        </div>
      </div>
      <div class="background-grid">
        <p class="section-index">01 · BACKGROUND</p>
        <div class="background-copy">
          <h2>The work I want to keep doing.</h2>
          <p>I studied engineering at Kettering University and built my analytical foundation through co-op work at Stellantis. At LightGuide, I worked directly with manufacturing operators to design AR workflows. I then co-founded JoyJobs.ai and built software around the job application process.</p>
          <p>Today, I’m Product Marketing &amp; Business Development Manager at Sensors, where my scope includes product requirements, UX design, and rollout planning for measurement software.</p>
          <p>I’m pursuing software product manager roles where I can work on complex workflows, from discovery through delivery. I’m open to relocation.</p>
          <a class="about-link" href="/work/">Explore my work</a>
        </div>
      </div>
      <section class="research-section" id="research" aria-labelledby="research-title">
        <div class="research-heading">
          <div>
            <p class="section-index">02 · RESEARCH</p>
            <h2 id="research-title">Representations, information, and the models we build.</h2>
          </div>
          <div class="research-intro">
            <p class="research-status">Independent research &amp; undergraduate thesis</p>
            <p>I study how representations organize information, what survives compression, and how models connect evidence to decisions. Select a project to read its full brief.</p>
          </div>
        </div>
        <div class="research-grid">
          <article class="research-card">
            <a class="research-card-link" href="/research/learned-representations/">
            <div class="research-visual representation-visual" aria-hidden="true">
              <span class="visual-index">01 / REPRESENTATION</span>
              <svg viewBox="0 0 320 300" fill="none" focusable="false">
                <g class="diagram-lines">
                  <circle cx="160" cy="150" r="103" />
                  <ellipse cx="160" cy="150" rx="103" ry="48" transform="rotate(-30 160 150)" />
                  <ellipse cx="160" cy="150" rx="103" ry="48" transform="rotate(30 160 150)" />
                  <ellipse cx="160" cy="150" rx="48" ry="103" />
                  <path d="M75 95 160 150 248 205M75 205 160 150 248 95M160 47V253" />
                </g>
                <g class="diagram-nodes">
                  <circle cx="160" cy="150" r="15" /><circle cx="75" cy="95" r="7" />
                  <circle cx="248" cy="205" r="7" /><circle cx="160" cy="47" r="7" />
                  <circle cx="75" cy="205" r="7" /><circle cx="248" cy="95" r="7" /><circle cx="160" cy="253" r="7" />
                </g>
              </svg>
            </div>
            <h3>{research["learned-representations"].title}</h3>
            <p>{research["learned-representations"].summary}</p>
              <span class="research-read">Read the brief <Arrow /></span>
            </a>
          </article>
          <article class="research-card">
            <a class="research-card-link" href="/research/career-information-compression/">
            <div class="research-visual compression-visual" aria-hidden="true">
              <span class="visual-index">02 / COMPRESSION</span>
              <svg viewBox="0 0 320 300" fill="none" focusable="false">
                <g class="diagram-lines">
                  <rect x="36" y="70" width="90" height="160" rx="4" />
                  <path d="M53 94H109M53 110H97M53 126H109M53 142H102M53 158H109M53 174H93M53 190H109M53 206H99" />
                  <path d="M140 150H183M174 141 183 150 174 159" />
                  <rect x="202" y="100" width="82" height="100" rx="4" />
                </g>
                <g class="diagram-emphasis"><path d="M219 124H267M219 141H254M219 158H267M219 175H247" /></g>
              </svg>
            </div>
            <h3>{research["career-information-compression"].title}</h3>
            <p>{research["career-information-compression"].summary}</p>
              <span class="research-read">Read the brief <Arrow /></span>
            </a>
          </article>
          <article class="research-card">
            <a class="research-card-link" href="/research/modeling-battery-degradation/">
            <div class="research-visual reasoning-visual" aria-hidden="true">
              <span class="visual-index">03 / MODELING</span>
              <svg viewBox="0 0 320 300" fill="none" focusable="false">
                <g class="diagram-lines"><path d="M42 52V246H287" /><path class="diagram-guide" d="M42 96H287M42 146H287M42 196H287" /><path d="M50 72C100 76 146 155 195 184S255 213 282 216" /><path d="M50 72C111 76 164 115 206 148S261 182 282 190" stroke-dasharray="5 6" /></g>
                <g class="diagram-nodes"><circle cx="70" cy="78" r="5" /><circle cx="110" cy="106" r="5" /><circle cx="153" cy="149" r="5" /><circle cx="195" cy="184" r="5" /><circle cx="238" cy="207" r="5" /><circle cx="277" cy="216" r="5" /></g>
              </svg>
            </div>
            <h3>{research["modeling-battery-degradation"].title}</h3>
            <p>{research["modeling-battery-degradation"].summary}</p>
              <span class="research-read">Read the brief <Arrow /></span>
            </a>
          </article>
        </div>
      </section>
    </div>
  </section>

  <section class="creative-section" aria-labelledby="creative-title">
    <div class="shell about-shell">
      <div class="creative-heading">
        <p class="section-index">03 · OUTSIDE OF WORK</p>
        <div>
          <h2 id="creative-title">Selected paintings.</h2>
          <p>Oil studies in color, texture, and composition. Select a painting to explore the brushwork and read more about the piece.</p>
        </div>
      </div>
      <ArtworkGallery />
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero { overflow: hidden; }
  .about-shell { border-inline: 1px solid var(--line); }
  .section-index { margin: 0; color: var(--accent-ink); font-size: .75rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  .intro-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, .38fr); gap: clamp(var(--space-32), 6vw, var(--space-96)); align-items: end; padding: clamp(var(--space-56), 7vw, var(--space-104)) clamp(var(--space-16), 3vw, var(--space-48)); }
  h1, h2 { margin: 0; color: var(--ink); font-weight: 650; letter-spacing: -.035em; line-height: 1.03; }
  h1 { max-width: 18ch; font-size: var(--text-h1); font-weight: var(--weight-h1); line-height: 1.12; }
  .intro-lead { max-width: 34rem; margin: var(--space-24) 0 0; color: var(--muted); font-size: clamp(1.05rem, 1.4vw, 1.2rem); line-height: 1.7; }
  .portrait-wrap { max-width: 285px; justify-self: end; width: 100%; }
  .portrait-wrap img { width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; }
  .portrait-caption { display: flex; flex-wrap: wrap; gap: var(--space-4); padding-top: var(--space-12); font-size: .7rem; }
  .portrait-caption span { color: var(--muted); font-weight: 500; }
  .portrait-caption strong { font-weight: 700; }
  .background-grid, .creative-heading { display: grid; grid-template-columns: minmax(150px, .38fr) minmax(0, 1fr); gap: var(--space-32); padding: clamp(var(--space-32), 4vw, var(--space-56)) clamp(var(--space-16), 3vw, var(--space-48)); border-top: 1px solid var(--line); }
  .background-copy { max-width: 43rem; }
  h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); }
  .background-copy p, .creative-heading div > p { max-width: 38rem; margin: var(--space-16) 0 0; color: var(--muted); font-size: 1rem; line-height: 1.8; }
  .about-link { display: inline-flex; gap: var(--space-12); margin-top: var(--space-24); color: var(--accent-link); font-size: .9rem; font-weight: 700; text-decoration: none; }
  .about-link span { color: inherit; }
  .about-link:hover { color: var(--link-hover); text-decoration: underline; text-underline-offset: .25em; }
  .creative-section { padding-bottom: clamp(var(--space-64), 7vw, var(--space-112)); background: var(--surface); }
  .creative-heading { border-bottom: 1px solid var(--line); }
  .research-section { scroll-margin-top: var(--space-24); padding: clamp(var(--space-40), 5vw, var(--space-72)) clamp(var(--space-16), 3vw, var(--space-48)); border-top: 1px solid var(--line); }
  .research-heading { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(var(--space-24), 5vw, var(--space-64)); align-items: start; margin-bottom: var(--space-40); }
  .research-heading h2 { max-width: 23ch; margin-top: var(--space-16); font-size: clamp(1.65rem, 2.5vw, 2.2rem); font-weight: 550; line-height: 1.2; }
  .research-intro { padding-top: var(--space-4); }
  .research-intro p { margin: var(--space-16) 0 0; color: var(--muted); line-height: 1.7; }
  .research-intro .research-status { margin: 0; color: var(--ink); font-size: .8rem; font-weight: 600; }
  .research-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-24); }
  .research-card { min-width: 0; }
  .research-card-link { display: block; height: 100%; text-decoration: none; border-radius: 4px; }
  .research-visual { transition: transform .22s ease, box-shadow .22s ease; }
  .research-card-link:hover .research-visual, .research-card-link:focus-visible .research-visual { transform: translateY(-4px); box-shadow: 0 12px 24px -12px var(--shadow); }
  .research-card-link:hover h3 { text-decoration: underline; text-underline-offset: .2em; }
  .research-card-link:hover .research-read { color: var(--link-hover); }
  .research-read { display: inline-flex; align-items: center; gap: var(--space-8); margin-top: var(--space-16); color: var(--accent-link); font-size: .9rem; font-weight: 600; }
  .research-visual { position: relative; overflow: hidden; aspect-ratio: 1 / 1.1; border: 1px solid var(--line); border-radius: 4px; background: var(--surface); }
  .visual-index { position: absolute; top: var(--space-16); left: var(--space-16); color: var(--muted); font-size: .62rem; font-weight: 600; letter-spacing: .1em; }
  .research-visual svg { position: absolute; inset: 12% 0 0; width: 100%; height: 88%; }
  .representation-visual { background: radial-gradient(ellipse at 50% 55%, color-mix(in srgb, var(--accent) 12%, var(--bg)), var(--surface) 75%); }
  .reasoning-visual { background: var(--ink); }
  .reasoning-visual .visual-index { color: var(--bg); opacity: .75; }
  .compression-visual { background: color-mix(in srgb, var(--accent) 6%, var(--surface)); }
  .diagram-lines { stroke: var(--muted); stroke-width: 1.25; }
  .reasoning-visual .diagram-lines { stroke: var(--bg); opacity: .7; }
  .diagram-guide { opacity: .15; stroke-dasharray: 3 5; }
  .diagram-nodes { fill: var(--accent); stroke: var(--ink); stroke-width: 1.25; }
  .diagram-emphasis { stroke: var(--accent); stroke-width: 4; stroke-linecap: round; }
  .research-card h3 { margin: var(--space-24) 0 var(--space-8); color: var(--ink); font-size: 1.08rem; font-weight: 600; letter-spacing: -.02em; line-height: 1.35; }
  .research-card-link > p { margin: 0; color: var(--muted); font-size: .95rem; line-height: 1.7; }
  @media (max-width: 720px) {
    .intro-grid { grid-template-columns: 1fr; }
    .portrait-wrap { justify-self: start; max-width: 230px; }
    .background-grid, .creative-heading { grid-template-columns: 1fr; gap: var(--space-16); }
    .research-heading { grid-template-columns: 1fr; gap: var(--space-24); }
    .research-heading h2 { max-width: 26ch; }
    .research-grid { grid-template-columns: 1fr; gap: var(--space-40); }
    .research-visual { aspect-ratio: 1.35 / 1; }
  }
</style>
