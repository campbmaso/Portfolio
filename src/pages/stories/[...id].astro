---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectWorkflow from "../../components/ProjectWorkflow.astro";
import Arrow from "../../components/Arrow.astro";
import { nextProjects, companyLogos, companyNames, companyHomepages } from "../../data/projects";
export async function getStaticPaths() {
  return (await getCollection("caseStudies")).map(study => ({ params: { id: study.id }, props: { study } }));
}
const { study } = Astro.props;
const { Content } = await render(study);
const studies = await getCollection("caseStudies");
const next = studies.find(item => item.id === nextProjects[study.id]);
---
<BaseLayout title={study.data.title} description={study.data.summary} canonicalPath={`/stories/${study.id}/`}>
  <article class="story-detail">
    <header class="story-header shell">
      <a class="text-link back" href="/work/">All work</a>
      {companyLogos[study.id] && <a class="story-company company-link" href={companyHomepages[study.id]} aria-label={`Visit ${companyNames[study.id]} homepage`}><img src={companyLogos[study.id]} alt={companyNames[study.id]} width="136" height="48" /></a>}
      <p class="eyebrow">{study.id === "instruction-modality-study" ? "Senior design project · " : ""}{study.data.eyebrow}</p>
      <h1>{study.data.title}</h1>
      <p class="story-deck">{study.data.summary}</p>
      <dl class="story-meta"><div><dt>Role</dt><dd>{study.data.role}</dd></div><div><dt>Timeframe</dt><dd>{study.data.timeframe}</dd></div>{study.data.status && <div><dt>Status</dt><dd>{study.data.status}</dd></div>}</dl>
      {study.data.scope && <p class="story-scope"><strong>My scope</strong> {study.data.scope}</p>}
    </header>
    <section class="overview-band" aria-label="Project summary"><div class="shell overview-grid"><div><h2>The problem</h2><p>{study.data.challenge}</p></div><div><h2>{study.data.outcomeLabel}</h2><p>{study.data.outcome}</p></div></div></section>
    {study.data.metrics.length > 0 && <section class="shell story-facts" aria-label={study.data.metricHeading}><h2>{study.data.metricHeading}</h2><div class="fact-list">{study.data.metrics.map(metric => <div><strong>{metric.value}</strong><span>{metric.label}</span>{metric.note && <small>{metric.note}</small>}</div>)}</div></section>}
    <div class="shell story-workflow"><ProjectWorkflow id={study.id} /></div>
    <div class="shell article-grid">
      <div class="article-content"><Content /></div>
      <aside class="article-aside" aria-label="Project context"><details><summary>Context & methods</summary><h2>Areas of work</h2><ul class="capability-list">{study.data.capabilities.map(item => <li>{item}</li>)}</ul><h2>Basis for the account</h2><ul>{study.data.evidence.map(item => <li>{item}</li>)}</ul></details></aside>
    </div>
    {next && <nav class="shell story-end" aria-label="Next project"><div><p class="eyebrow">Next project · {next.data.context}</p><h2><a href={`/stories/${next.id}/`}>{next.data.title}</a></h2></div><a class="text-link" href={`/stories/${next.id}/`} aria-label={`Next project: ${next.data.title}`}>Continue reading <Arrow /></a></nav>}
  </article>
</BaseLayout>
<style>
  .story-header { padding-block: var(--space-40); }
  .back { margin-bottom: var(--space-24); }
  .story-company { display: flex; width: fit-content; margin: 0 0 var(--space-24); }
  .story-company img { width: 136px; height: 48px; object-fit: contain; object-position: left center; filter: grayscale(1); }
  h1 { max-width: 24ch; margin: var(--space-16) 0; font-size: var(--text-h1); font-weight: var(--weight-h1); letter-spacing: -.035em; line-height: 1.12; }
  .story-deck { max-width: 48rem; margin: 0; color: var(--muted); font-size: 1.1rem; line-height: 1.7; }
  .story-meta { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-24); margin: var(--space-32) 0 0; padding-top: var(--space-24); border-top: 1px solid var(--line); }
  .story-meta dt { margin-bottom: var(--space-8); color: var(--muted); font-size: .8rem; }
  .story-meta dd { margin: 0; font-size: .95rem; font-weight: 600; }
  .story-scope { margin: var(--space-24) 0 0; color: var(--muted); font-size: .9rem; }
  .story-scope strong { margin-right: var(--space-8); color: var(--ink); }
  .overview-band { padding-block: var(--space-32); background: var(--surface); border-block: 1px solid var(--line); }
  .overview-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-48); }
  .overview-grid h2 { margin: 0 0 var(--space-12); font-size: .85rem; font-weight: 750; }
  .overview-grid p { max-width: 35rem; margin: 0; font-size: 1rem; line-height: 1.75; }
  .story-facts { padding-block: var(--space-32); border-bottom: 1px solid var(--line); }
  .story-facts h2 { margin: 0 0 var(--space-24); color: var(--muted); font-size: .8rem; font-weight: 650; }
  .fact-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: var(--space-32); }
  .fact-list > div { display: flex; flex-direction: column; gap: var(--space-8); }
  .fact-list strong { font-size: 1.8rem; line-height: 1.2; letter-spacing: -.02em; }
  .fact-list span { font-size: .9rem; font-weight: 650; }
  .fact-list small { max-width: 26rem; color: var(--muted); font-size: .8rem; }
  .story-workflow:has(figure) { padding-top: var(--space-40); }
  .article-grid { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: var(--space-64); padding-block: var(--space-48) var(--space-64); }
  .article-content { max-width: 47rem; }
  .article-content :global(h2) { margin: var(--space-40) 0 var(--space-16); font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 650; letter-spacing: -.025em; line-height: 1.25; }
  .article-content :global(h2:first-child) { margin-top: 0; }
  .article-content :global(p), .article-content :global(li) { color: var(--muted); font-size: 1rem; line-height: 1.85; }
  .article-content :global(p) { margin: 0 0 var(--space-16); }
  .article-content :global(a) { color: var(--accent-link); text-underline-offset: .2em; }
  .article-aside { padding-top: var(--space-8); }
  .article-aside details { border-block: 1px solid var(--line); padding-block: var(--space-16); }
  .article-aside summary { cursor: pointer; font-size: .85rem; font-weight: 650; }
  .article-aside h2 { margin: var(--space-24) 0 var(--space-12); color: var(--muted); font-size: .8rem; font-weight: 650; }
  .article-aside ul { padding-left: var(--space-16); margin: 0; }
  .article-aside li { margin-top: var(--space-8); color: var(--muted); font-size: .8rem; line-height: 1.6; }
  .article-aside .capability-list { display: flex; flex-wrap: wrap; gap: var(--space-8); padding: 0; list-style: none; }
  .capability-list li { margin: 0; padding: var(--space-4) var(--space-12); border: 1px solid var(--line); border-radius: 999px; }
  .story-end { display: flex; gap: var(--space-32); justify-content: space-between; align-items: center; border-top: 1px solid var(--line); padding-block: var(--space-32) var(--space-64); }
  .story-end h2 { max-width: 28ch; margin: var(--space-12) 0 0; font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 650; letter-spacing: -.025em; line-height: 1.3; }
  .story-end h2 a { text-decoration: none; }
  .story-end h2 a:hover { text-decoration: underline; }
  .story-end > .text-link { flex-shrink: 0; }
  @media (max-width: 820px) { .article-grid { grid-template-columns: 1fr; gap: var(--space-32); } }
  @media (max-width: 720px) {
    .story-meta { grid-template-columns: 1fr; gap: var(--space-16); }
    .overview-grid { grid-template-columns: 1fr; gap: var(--space-24); }
    .story-end { align-items: start; flex-direction: column; }
  }
</style>
