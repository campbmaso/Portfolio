---
import { getCollection, render, type CollectionEntry } from "astro:content";
import WorkStoryLayout from "../../layouts/WorkStoryLayout.astro";
import ResearchArtwork from "../../components/ResearchArtwork.astro";
import Arrow from "../../components/Arrow.astro";
export async function getStaticPaths() {
  return (await getCollection("research")).map(brief => ({ params: { id: brief.id }, props: { brief } }));
}
interface Props { brief: CollectionEntry<"research">; }
const { brief } = Astro.props;
const { Content } = await render(brief);
const otherBriefs = (await getCollection("research")).filter(item => item.id !== brief.id).sort((a, b) => a.data.order - b.data.order);
---
<WorkStoryLayout title={brief.data.title} summary={brief.data.summary} category="Research" eyebrow="Research brief" canonicalPath={`/research/${brief.id}/`} resultHeading={brief.data.outcomeLabel} outcome={brief.data.outcome ?? brief.data.question} metrics={brief.data.metrics} metricHeading="Study scope">
  <Fragment slot="context">
    <div class="brief-artwork"><ResearchArtwork id={brief.id} landscape /></div>
    <dl><div><dt>Research status</dt><dd>{brief.data.status}</dd></div></dl>
  </Fragment>
  <Content />
  <Fragment slot="related">
    <h2>More research</h2>
    {otherBriefs.map(item => <a class="text-link" href={`/research/${item.id}/`}>{item.data.title} <Arrow /></a>)}
    <a class="text-link" href="/about/#research">Back to research <Arrow /></a>
    <a class="text-link" href="/work/">All work <Arrow /></a>
  </Fragment>
</WorkStoryLayout>
<style>
  .brief-artwork { margin: calc(-1 * var(--space-24)) calc(-1 * var(--space-24)) var(--space-24); }
</style>
