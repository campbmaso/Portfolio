---
import { getCollection, render, type CollectionEntry } from "astro:content";
import WorkStoryLayout from "../../layouts/WorkStoryLayout.astro";
import Arrow from "../../components/Arrow.astro";
export async function getStaticPaths() {
  return (await getCollection("research")).map(brief => ({ params: { id: brief.id }, props: { brief } }));
}
interface Props { brief: CollectionEntry<"research">; }
const { brief } = Astro.props;
const { Content } = await render(brief);
const otherBriefs = (await getCollection("research")).filter(item => item.id !== brief.id).sort((a, b) => a.data.order - b.data.order);
---
<WorkStoryLayout title={brief.data.title} summary={brief.data.summary} category="Research" eyebrow={brief.data.category} canonicalPath={`/research/${brief.id}/`} resultHeading="Key findings" outcome={brief.data.takeaway} metrics={brief.data.scope} metricHeading="Study scope">
  <Fragment slot="context">
    <dl>
      <div><dt>My role</dt><dd>{brief.data.role}</dd></div>
      <div><dt>Context</dt><dd>{brief.data.context}</dd></div>
      <div><dt>Timeframe</dt><dd>{brief.data.period}</dd></div>
      <div><dt>Research status</dt><dd>{brief.data.status}</dd></div>
    </dl>
  </Fragment>
  <section class="story-challenge" aria-labelledby="question-title">
    <h2 id="question-title">The research question</h2>
    <p>{brief.data.question}</p>
  </section>
  <Content />
  <details class="story-notes">
    <summary>Methods used</summary>
    <ul>{brief.data.methods.map(method => <li>{method}</li>)}</ul>
  </details>
  <Fragment slot="related">
    <h2>More research</h2>
    {otherBriefs.map(item => <a class="text-link" href={`/research/${item.id}/`}>{item.data.title} <Arrow /></a>)}
    <a class="text-link" href="/about/#research">Back to research <Arrow /></a>
    <a class="text-link" href="/work/">All work <Arrow /></a>
  </Fragment>
</WorkStoryLayout>
