---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" pageClass="not-found-page">
  <section class="not-found">
    <div class="shell">
      <p class="eyebrow">404 · Page not found</p>
      <h1>Let’s get you back on track.</h1>
      <p>This page may have moved. You can return home or explore the product stories.</p>
      <a class="button button-primary" href="/">Back to the portfolio</a>
    </div>
  </section>
</BaseLayout>
