---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" pageClass="not-found-page">
  <section class="not-found">
    <div class="shell">
      <p class="eyebrow">404 · Constraint found</p>
      <h1>This path does not lead to a product.</h1>
      <p>The useful move is to return to the evidence and choose another route.</p>
      <a class="button button-dark" href="/">Back to the portfolio <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
