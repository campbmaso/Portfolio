---
type Point = { x: number; y: number };

// Three outward Koch refinements keep the fractal crisp without a large SVG.
function snowflake(radius: number, rotation: number) {
  let points: Point[] = Array.from({ length: 3 }, (_, i) => {
    const angle = rotation + i * Math.PI * 2 / 3;
    return { x: radius * Math.cos(angle), y: radius * Math.sin(angle) };
  });
  for (let iteration = 0; iteration < 3; iteration++) {
    points = points.flatMap((a, i) => {
      const b = points[(i + 1) % points.length];
      const dx = (b.x - a.x) / 3;
      const dy = (b.y - a.y) / 3;
      return [a, { x: a.x + dx, y: a.y + dy },
        { x: a.x + 1.5 * dx + Math.sqrt(3) * dy / 2, y: a.y + 1.5 * dy - Math.sqrt(3) * dx / 2 },
        { x: a.x + 2 * dx, y: a.y + 2 * dy }];
    });
  }
  return points.map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(2)} ${p.y.toFixed(2)}`).join(' ') + 'Z';
}

// Two sizes, rotated 30 degrees apart, on a triangular lattice.
const radius = 17;
const stepX = 2 * Math.sqrt(3) * radius;
const stepY = 3 * radius;
const tiles: { x: number; y: number; size: string }[] = [];
for (let row = -1; row < Math.ceil(640 / stepY) + 1; row++) {
  for (let column = -1; column < Math.ceil(1200 / stepX) + 1; column++) {
    const x = column * stepX + (row % 2) * stepX / 2;
    const y = row * stepY;
    tiles.push({ x, y, size: 'large' },
      { x: x + stepX / 2, y: y + radius, size: 'small' },
      { x, y: y + 2 * radius, size: 'small' });
  }
}
---
<div class="hero-pattern" aria-hidden="true">
  <svg viewBox="0 0 1200 640" preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <path id="koch-large" d={snowflake(radius * Math.sqrt(3), 0)} />
      <path id="koch-small" d={snowflake(radius, Math.PI / 6)} />
    </defs>
    {tiles.map(tile => <g transform={`translate(${tile.x} ${tile.y})`}>
      <g class="snowflake" data-x={tile.x} data-y={tile.y}>
        <use href={`#koch-${tile.size}`} />
      </g>
    </g>)}
  </svg>
</div>
<button class="motion-toggle" type="button" aria-pressed="false" hidden>Pause background</button>

<script>
  document.querySelectorAll<HTMLElement>('.hero-pattern').forEach(pattern => {
    const hero = pattern.parentElement!;
    const svg = pattern.querySelector('svg')!;
    const toggle = hero.querySelector<HTMLButtonElement>('.motion-toggle')!;
    const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const tiles = Array.from(pattern.querySelectorAll<SVGGElement>('.snowflake')).map(element => ({
      element, x: Number(element.dataset.x), y: Number(element.dataset.y),
    }));
    let paused = false;
    let frame = 0;
    let pointerX = 0;
    let pointerY = 0;
    const enabled = () => !paused && !preference.matches && pointer.matches;
    const reset = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      tiles.forEach(({ element }) => element.classList.remove('is-lifted'));
    };
    const update = () => {
      reset();
      pattern.classList.toggle('is-paused', !enabled());
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.textContent = paused ? 'Play background' : 'Pause background';
      toggle.hidden = preference.matches || !pointer.matches;
    };
    const lift = () => {
      frame = 0;
      const matrix = svg.getScreenCTM();
      if (!matrix || !enabled()) return;
      const point = new DOMPoint(pointerX, pointerY).matrixTransform(matrix.inverse());
      for (const tile of tiles) {
        // Scale the hover neighborhood with the smaller tiles.
        const proximity = Math.max(0, 1 - Math.hypot(point.x - tile.x, point.y - tile.y) / 57.5);
        tile.element.classList.toggle('is-lifted', proximity > 0);
        if (proximity > 0) {
          tile.element.style.setProperty('--lift', `${-3 - proximity * 9}px`);
          tile.element.style.setProperty('--grow', String(1 + proximity * .035));
        }
      }
    };
    hero.addEventListener('pointermove', event => {
      if (!enabled() || event.pointerType === 'touch') return;
      pointerX = event.clientX;
      pointerY = event.clientY;
      if (!frame) frame = requestAnimationFrame(lift);
    }, { passive: true });
    hero.addEventListener('pointerleave', reset);
    window.addEventListener('blur', reset);
    window.addEventListener('scroll', reset, { passive: true });
    toggle.addEventListener('click', () => { paused = !paused; update(); });
    preference.addEventListener('change', update);
    pointer.addEventListener('change', update);
    update();
  });
</script>

<style>
  .hero-pattern { position: absolute; inset: 0; pointer-events: none; overflow: hidden; color: var(--accent); opacity: .5; mask-image: linear-gradient(90deg, transparent 15%, #000 90%); }
  svg { display: block; width: 100%; height: 100%; }
  .snowflake { fill: var(--accent-tint); fill-opacity: .3; stroke: currentColor; stroke-opacity: .16; stroke-width: .65; transform-box: fill-box; transform-origin: center; transform: translateY(0) scale(.97); transition: transform .8s cubic-bezier(.2,.7,.2,1) .275s, stroke-opacity .8s ease .275s, filter .8s ease .275s; }
  .snowflake.is-lifted { transform: translateY(var(--lift)) scale(var(--grow)); stroke-opacity: .65; filter: drop-shadow(0 7px 4px var(--shadow)); transition-duration: .18s; transition-delay: 0s; }
  .is-paused .snowflake { transition: none; }
  .motion-toggle { position: absolute; z-index: 2; right: var(--space-24); bottom: var(--space-16); padding: var(--space-8) var(--space-12); border: 1px solid var(--line); border-radius: 4px; color: var(--muted); background: var(--bg); font-size: .7rem; }
  .motion-toggle[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { .snowflake, .snowflake.is-lifted { transition: none; transform: none; filter: none; } }
  @media (max-width: 720px) { .hero-pattern { opacity: .2; mask-image: linear-gradient(90deg, transparent, #000); } }
</style>
