---
import { siteConfig } from "../site-config";
---

<header class="site-header">
  <div class="shell nav-shell glass-surface">
    <a class="brand" href="/" aria-label={`${siteConfig.name}, home`}>
      <span class="brand-mark" aria-hidden="true"><span>MC</span></span>
      <span class="brand-name">{siteConfig.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="/#work">Work</a>
      <a href="/#approach">Operating system</a>
      <a href="/#background">Story</a>
      <a class="nav-cta" href={siteConfig.linkedin} target="_blank" rel="noreferrer">
        Connect <span aria-hidden="true">↗</span>
      </a>
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Open navigation">Menu</summary>
      <nav aria-label="Mobile navigation">
        <a href="/#work">Work</a>
        <a href="/#approach">Operating system</a>
        <a href="/#background">Story</a>
        <a href={siteConfig.linkedin} target="_blank" rel="noreferrer">Connect ↗</a>
      </nav>
    </details>
  </div>
</header>
