---
import { companyLogos, companyNames, companyHomepages } from '../data/projects';
interface Props { id: string; featured?: boolean }
const { id, featured = false } = Astro.props;
const brand = id.includes('sensors') ? 'sensors' : id.includes('lightguide') || id === 'instruction-modality-study' ? 'lightguide' : id.includes('stellantis') ? 'stellantis' : 'joyjobs';
---
<div class:list={['work-artwork', `art-${brand}`, { 'art-featured': featured }]}>
  <a class="art-logo" href={companyHomepages[id]} aria-label={`Visit ${companyNames[id]} homepage`}><img src={companyLogos[id]} alt={companyNames[id]} width="180" height="48" /></a>
  {featured ? <div class="featured-workflow" aria-hidden="true">
      <span class="featured-transition">CareerAI <span>→</span> ResumeAI</span>
      <svg viewBox="0 0 460 200" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false">
        <rect x="20" y="12" width="136" height="176" rx="6" class="faint" />
        <rect x="304" y="12" width="136" height="176" rx="6" />
        {[20, 304].map(x => <>
          <path d={`M${x+20} 40h68m-68 12h45`} />
          <path class="faint" d={`M${x+20} 78h96m-96 44h96`} />
          {[91, 103, 135, 147, 159].map(y => <path d={`M${x+20} ${y}h${y === 103 || y === 159 ? 70 : 96}`} />)}
        </>)}
        <path d="M188 100h84m-12-12 12 12-12 12" />
        <path class="faint" d="M174 40h112M174 160h112" stroke-dasharray="3 6" />
      </svg>
      <strong>Tailored content.<br />Original formatting.</strong>
    </div> :
    <svg viewBox="0 0 600 340" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2">
      {id === 'sensors-platform-strategy' && <>
        {[130, 190, 250].map(y => <path class="faint" d={`M60 ${y}H540`} />)}
        <path d="M60 235H120L145 205 175 220 215 140 250 195 290 170 320 220 360 120 400 180 440 150 480 175H540" />
        {[145, 215, 290, 360, 440].map((x, i) => <circle cx={x} cy={[205,140,170,120,150][i]} r="5" fill="currentColor" stroke="none" />)}
      </>}
      {id === 'lightguide-ar-workflows' && <>
        <path class="faint" d="m70 230 230-130 230 130-230 130Z M185 165l230 130M415 165 185 295M128 198l230 130M472 198 242 328" />
        <path d="m222 192 78-44 78 44-78 44Zm0 0v74l78 44 78-44v-74M300 236v74" />
        <path stroke-width="4" d="M195 185v-28h28M377 157h28v28M405 277v28h-28M223 305h-28v-28" />
      </>}
      {id === 'subscription-model' && <>
        {[110, 142, 174].map((x, index) => <rect x={x} y={135 + index*24} width="112" height="74" rx="6" class={index < 2 ? 'faint' : undefined} />)}
        <path d="M310 207h58m-12-12 12 12-12 12" />
        <rect x="405" y="130" width="120" height="152" rx="8" />
        <path d="M437 197a28 28 0 0 1 48-18l8 8m0-18v18h-18M493 217a28 28 0 0 1-48 18l-8-8m0 18v-18h18" />
        <text x="194" y="304" text-anchor="middle" stroke="none" fill="currentColor" font-size="16">Usage packages</text>
        <text x="465" y="304" text-anchor="middle" stroke="none" fill="currentColor" font-size="16">Subscription</text>
      </>}
      {id === 'resume-score' && <>
        <rect x="78" y="120" width="120" height="166" rx="6" class="faint" />
        {[147, 170, 193, 216, 239, 262].map(y => <path d={`M98 ${y}h${y === 170 || y === 239 ? 57 : 80}`} />)}
        <path d="M220 202h56m-12-12 12 12-12 12" />
        <rect x="300" y="120" width="222" height="166" rx="8" />
        <text x="320" y="151" stroke="none" fill="currentColor" font-size="18">Score breakdown</text>
        <path class="faint" d="M320 165h182M320 217h182" />
        <circle cx="333" cy="191" r="9" /><path d="m329 191 3 3 6-7" />
        <circle cx="333" cy="243" r="9" /><path d="M333 238v10m-5-5h10" />
        <text x="355" y="197" stroke="none" fill="currentColor" font-size="16">Technical skills</text>
        <text x="355" y="249" stroke="none" fill="currentColor" font-size="16">Soft skills</text>
      </>}
      {id === 'stellantis-analytical-foundation' && <>
        <circle class="faint" cx="300" cy="205" r="110" /><circle cx="300" cy="205" r="76" />
        {[0,60,120,180,240,300].map(angle => <path transform={`rotate(${angle} 300 205)`} d="M300 188c-40-30-27-67 0-50 24 15 30 35 11 55" />)}
        <circle cx="300" cy="205" r="18" />
      </>}
      {id === 'instruction-modality-study' && <>
        {[115,265,415].map(x => <><rect x={x} y="125" width="85" height="145" rx="5" class="faint" />
          <path d={`M${x+20} 155h45m-45 25h30m-30 25h45`} /><circle cx={x+42.5} cy="240" r="9" /></>)}
        <path d="M212 200h40m100 0h40" />
      </>}
    </svg>}
</div>
<style>
  .work-artwork { --art: var(--joyjobs-brand); --art-deep: var(--joyjobs-deep); position: relative; overflow: hidden; border-radius: 5px; aspect-ratio: 16 / 9; color: var(--brand-on-color); background: linear-gradient(135deg, var(--art), var(--art-deep)); }
  .art-sensors { --art: var(--sensors-brand); --art-deep: var(--sensors-deep); }
  .art-lightguide { --art: var(--lightguide-brand); --art-deep: var(--lightguide-deep); }
  .art-stellantis { --art: var(--muted); --art-deep: var(--ink); }
  .art-logo { position: absolute; z-index: 2; top: var(--space-24); left: var(--space-24); display: block; width: fit-content; }
  .art-logo img { width: 140px; height: 34px; object-fit: contain; object-position: left center; filter: brightness(0) invert(1); }
  .art-sensors .art-logo img { width: 58px; height: 46px; }
  .art-logo:focus-visible { outline-color: var(--brand-on-color); }
  svg { width: 100%; height: 100%; display: block; opacity: .75; }
  .faint { opacity: .28; }
  .art-featured { aspect-ratio: auto; min-height: 490px; display: flex; align-items: end; padding: var(--space-40); }
  .art-featured::before, .art-featured::after { content: ''; position: absolute; width: 100%; aspect-ratio: 1; border: 1px solid currentColor; opacity: .15; transform: rotate(-25deg); top: -30%; left: 40%; }
  .art-featured::after { top: -10%; left: 60%; }
  .art-featured .art-logo { top: var(--space-40); left: var(--space-40); }
  .art-featured .art-logo img { width: 190px; height: 48px; }
  .featured-workflow { position: relative; width: 100%; margin-top: var(--space-80); }
  .featured-transition { display: flex; gap: var(--space-16); align-items: center; font-size: 1rem; font-weight: 500; }
  .featured-transition > span { opacity: .6; }
  .featured-workflow svg { height: auto; margin: var(--space-24) 0; }
  .featured-workflow strong { display: block; font-size: clamp(1.7rem, 2.6vw, 2.25rem); font-weight: 500; letter-spacing: -.04em; line-height: 1.2; }
  @media (max-width: 720px) { .art-featured { min-height: 330px; padding: var(--space-32); } .art-featured .art-logo { top: var(--space-24); left: var(--space-32); } }
</style>
