---
import type { CollectionEntry } from "astro:content";

interface Props {
  study: CollectionEntry<"caseStudies">;
  index: number;
}

const { study, index } = Astro.props;
const metric = study.data.metrics[0];
---

<article class="case-card">
  <a href={`/work/${study.id}/`} aria-label={`Read case study: ${study.data.title}`}>
    <div class="case-card-topline">
      <span class="case-index">0{index + 1}</span>
      <span class="case-eyebrow">{study.data.eyebrow}</span>
    </div>
    <div class="case-card-copy">
      <p class="case-context">{study.data.context} · {study.data.timeframe}</p>
      <h3>{study.data.title}</h3>
      <p>{study.data.summary}</p>
    </div>
    <div class="case-card-proof">
      <div>
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
      </div>
      <span class="case-arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</article>
