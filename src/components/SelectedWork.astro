---
import type { CollectionEntry } from 'astro:content';
import { companyLogos, companyNames, companyHomepages, projectDecisions } from '../data/projects';
import Arrow from './Arrow.astro';
interface Props { studies: CollectionEntry<'caseStudies'>[] }
const { studies } = Astro.props;
const brands: Record<string, string> = { 'resume-ai': 'joyjobs', 'sensors-platform-strategy': 'sensors', 'lightguide-ar-workflows': 'lightguide' };
---
<div class="selected-work" data-selected-tabs>
  <div class="selected-panels">
    {studies.map(study => <article class={`selected-panel brand-${brands[study.id]}`} id={`selected-${study.id}`} aria-labelledby={`selected-title-${study.id}`}>
      <div class="selected-details">
        <p class="eyebrow">{study.data.eyebrow}</p>
        <p class="selected-label">The challenge</p>
        <p>{study.data.challenge}</p>
        <p class="selected-label">The product decision</p>
        <p>{projectDecisions[study.id].detail}</p>
        <p class="selected-label">Areas of work</p>
        <ul>{study.data.capabilities.slice(0, 3).map(item => <li>{item}</li>)}</ul>
      </div>
      <div class="selected-feature">
        <div class="feature-pattern" aria-hidden="true"><span></span><span></span><span></span></div>
        <a class="feature-company" href={companyHomepages[study.id]} aria-label={`Visit ${companyNames[study.id]} homepage`}>
          <img src={companyLogos[study.id]} alt={companyNames[study.id]} width="200" height="56" />

        </a>
        <div class="feature-story">
          <p class="feature-role">{study.data.role} · {study.data.timeframe}</p>
          <h3 id={`selected-title-${study.id}`}><a href={`/stories/${study.id}/`}>{study.data.title}</a></h3>
          <a class="feature-link" href={`/stories/${study.id}/`} aria-label={`Read the story: ${study.data.title}`}>Read the story <Arrow /></a>
        </div>
      </div>
    </article>)}
  </div>
  <div class="selected-tabs" aria-label="Selected work by company" hidden>
    {studies.map(study => <button class={`brand-${brands[study.id]}`} type="button" id={`selected-tab-${study.id}`} aria-controls={`selected-${study.id}`} aria-label={companyNames[study.id]}>
      <span class="tab-company"><img src={companyLogos[study.id]} alt="" width="180" height="48" /></span>
    </button>)}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-selected-tabs]').forEach(root => {
    const tablist = root.querySelector<HTMLElement>('.selected-tabs')!;
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('button'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.selected-panel'));
    const activate = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
      if (focus) tabs[index].focus();
    };
    tablist.hidden = false;
    tablist.setAttribute('role', 'tablist');
    tabs.forEach((tab, index) => {
      tab.setAttribute('role', 'tab');
      panels[index].setAttribute('role', 'tabpanel');
      panels[index].setAttribute('aria-labelledby', tab.id);
      panels[index].tabIndex = 0;
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') activate(index); });
      tab.addEventListener('keydown', event => {
        const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : event.key === 'ArrowLeft' ? (index - 1 + tabs.length) % tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : null;
        if (next !== null) { event.preventDefault(); activate(next, true); }
      });
    });
    const linked = panels.findIndex(panel => `#${panel.id}` === window.location.hash);
    activate(linked >= 0 ? linked : 0);
  });
</script>
<style>
  .brand-joyjobs { --brand: var(--joyjobs-brand); --brand-deep: var(--joyjobs-deep); }
  .brand-sensors { --brand: var(--sensors-brand); --brand-deep: var(--sensors-deep); }
  .brand-lightguide { --brand: var(--lightguide-brand); --brand-deep: var(--lightguide-deep); }
  .selected-panel { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.5fr); gap: clamp(var(--space-32), 5vw, var(--space-64)); padding-block: var(--space-16) var(--space-48); }
  .selected-panel[hidden], .selected-tabs[hidden] { display: none; }
  .selected-details { padding-top: var(--space-4); }
  .selected-details > .eyebrow { color: var(--muted); font-size: .65rem; }
  .selected-details .selected-label { margin: var(--space-24) 0 var(--space-8); font-size: .85rem; font-weight: 650; }
  .selected-details > p:not(.eyebrow):not(.selected-label), .selected-details li { color: var(--muted); font-size: .9rem; line-height: 1.7; }
  .selected-details > p:not(.eyebrow):not(.selected-label) { margin: 0; }
  .selected-details ul { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-16); padding: 0; margin: 0; list-style: none; }
  .selected-details li::before { content: '✓'; margin-right: var(--space-8); color: var(--brand-deep); }
  .selected-feature { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-64); min-height: 460px; padding: clamp(var(--space-24), 3vw, var(--space-40)); border-radius: 8px; background: linear-gradient(145deg, var(--brand), var(--brand-deep)); color: var(--brand-on-color); box-shadow: 0 18px 28px -20px var(--shadow); }
  .feature-company { display: flex; align-items: center; gap: var(--space-12); width: fit-content; position: relative; z-index: 1; text-decoration: none; }
  .feature-company img { width: 190px; height: 54px; object-fit: contain; object-position: left center; filter: brightness(0) invert(1); }
  .brand-sensors .feature-company img { width: 110px; height: 88px; }
  .feature-story { position: relative; z-index: 1; }
  .feature-role { max-width: 36rem; margin: 0 0 var(--space-16); font-size: .75rem; line-height: 1.6; }
  .feature-story h3 { margin: 0 0 var(--space-24); max-width: 24ch; font-size: clamp(1.65rem, 2.7vw, 2.35rem); font-weight: 600; line-height: 1.2; letter-spacing: -.025em; }
  .feature-story h3 a { text-decoration: none; }
  .feature-story h3 a:hover { text-decoration: underline; text-underline-offset: .15em; }
  .feature-link { display: inline-flex; align-items: center; gap: var(--space-8); font-size: .85rem; font-weight: 650; text-decoration: none; }
  .feature-link:hover { text-decoration: underline; text-underline-offset: .2em; }
  .selected-feature :focus-visible { outline-color: var(--brand-on-color); }
  .feature-pattern { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .feature-pattern span { position: absolute; width: 80%; aspect-ratio: 1; top: -50%; right: -20%; border: 1px solid var(--brand-on-color); border-radius: 50%; opacity: .13; }
  .feature-pattern span:nth-child(2) { top: -30%; right: -5%; }
  .feature-pattern span:nth-child(3) { top: -10%; right: -20%; }
  .brand-sensors .feature-pattern span { border-radius: 8px; transform: rotate(-25deg); }
  .brand-lightguide .feature-pattern span { border-radius: 0; transform: rotate(35deg); }
  .selected-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--line); }
  .selected-tabs button { display: flex; align-items: center; justify-content: center; padding: var(--space-32) var(--space-24); min-height: 112px; border: 0; border-top: 2px solid transparent; background: transparent; }
  .selected-tabs button + button { border-left: 1px solid var(--line); }
  .tab-company { display: flex; align-items: center; justify-content: center; gap: var(--space-8); filter: grayscale(1); opacity: .35; transition: opacity .18s ease, filter .18s ease; }
  .tab-company img { width: 170px; height: 48px; object-fit: contain; }
  .brand-sensors .tab-company img { width: 88px; height: 70px; }
  .selected-tabs button[aria-selected='true'] { border-top-color: var(--brand); background: var(--bg); }
  .selected-tabs button[aria-selected='true'] .tab-company { filter: none; opacity: 1; }
  .selected-tabs button:hover { background: var(--bg); }
  @media (max-width: 720px) {
    .selected-panel { grid-template-columns: 1fr; gap: var(--space-24); }
    .selected-feature { min-height: 360px; }
    .selected-tabs button { padding: var(--space-16) var(--space-8); min-height: 84px; }
    .tab-company { gap: var(--space-4); flex-direction: column; }
    .tab-company img { width: 100%; max-width: 115px; height: 36px; }
    .brand-sensors .tab-company img { width: 64px; height: 51px; }
  }
</style>
