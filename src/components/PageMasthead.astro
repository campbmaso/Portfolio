---
interface Props { label: string; heading?: boolean }
const { label, heading = false } = Astro.props;
const Label = heading ? 'h1' : 'p';
---
<header class="shell page-masthead"><Label class="masthead-label">{label}</Label></header>
<style>
  .page-masthead { padding: var(--space-24) var(--space-16); }
  .masthead-label { margin: 0; color: var(--accent); font-size: 1rem; font-weight: 600; }
  @media (max-width: 720px) { .page-masthead { padding-inline: 0; } }
</style>
