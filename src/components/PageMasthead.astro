---
interface Props { label: string }
const { label } = Astro.props;
---
<header class="shell page-masthead"><p>{label}</p></header>
<style>
  .page-masthead { padding: var(--space-24) var(--space-16); }
  p { margin: 0; color: var(--accent); font-size: 1rem; font-weight: 600; }
  @media (max-width: 720px) { .page-masthead { padding-inline: 0; } }
</style>
