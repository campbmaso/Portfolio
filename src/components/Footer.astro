---
import { siteConfig } from "../site-config";
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="shell footer-grid">
    <div>
      <p class="footer-kicker">Open to the right next problem</p>
      <h2>Let's build what should exist next.</h2>
    </div>
    <div class="footer-actions">
      <a class="button button-light" href={siteConfig.linkedin} target="_blank" rel="noreferrer">
        Connect on LinkedIn <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link light-link" href={siteConfig.github} target="_blank" rel="noreferrer">
        Explore my GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
  <div class="shell footer-meta">
    <p>© {year} {siteConfig.name}</p>
    <p>Designed with curiosity · Built on Astro + Cloudflare</p>
  </div>
</footer>
