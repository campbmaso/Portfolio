---
// Public summaries grounded in the local geometry protocols, compression study
// reports, and undergraduate-thesis notes. Source documents stay outside the site.
const projects = [
  {
    id: "semantic", number: "01", category: "Representation & geometry",
    title: "Semantic representations of experience",
    status: "Independent research · In progress",
    summary: "How does the way we represent experience change what we can compare, retrieve, and explain?",
    sections: [
      { title: "The question", text: "A single embedding is a compact representation of a career document, but it can obscure relationships between skills, actions, and the contexts in which they occurred. I’m investigating how different representations preserve that structure." },
      { title: "The approach", text: "I compare whole-document points and token-derived linear subspaces in a shared learned embedding space. A related experiment projects documents onto named, job-specific semantic directions to make the comparison easier to inspect. A separate structural pilot tests which combinations of experience attributes survive flattening and low-rank compression." },
      { title: "What I’m examining", text: "The experiments track how geometric and scoring choices affect rankings, what information their readouts expose, and which relationships are lost. Semantic alignment is the measurement under study; it is not a calibrated measure of proficiency or hiring suitability." },
    ],
    methods: "Embeddings · Linear subspaces · Semantic projections · Structural recovery",
  },
  {
    id: "compression", number: "02", category: "Information & compression",
    title: "Career compression & rate–distortion",
    status: "Independent research · Pilot studies complete",
    summary: "What survives when a detailed work history becomes a short résumé—and does the target job change what should be preserved?",
    sections: [
      { title: "The question", text: "A résumé compresses a much richer history into a limited amount of text. I’m studying the tradeoff between that space budget and the preservation of factual, contextually relevant career information." },
      { title: "The approach", text: "I built an evaluation pipeline that extracts contextual claims with source evidence, then measures factual support and coverage. The studies record token budgets and model-based code length, using distortion defined as one minus graded factual F1. Job-conditioned evaluation asks which information matters for a particular role." },
      { title: "The current result", text: "A single-person, single-job pilot compared 24 generated summaries across four token budgets, with three draws per condition and budget. Job-conditioned summaries had higher mean job-relevant F1 at all four budgets. These are observed compression tradeoffs for a fixed model and case, rather than an optimal rate–distortion frontier or a test of hiring outcomes." },
    ],
    methods: "Claim-level evaluation · Token budgets · Job conditioning · Reproducible analyses",
  },
  {
    id: "thesis", number: "03", category: "Experimental modeling",
    title: "Modeling battery degradation",
    status: "Undergraduate thesis · Kettering × Stellantis",
    summary: "Connecting controlled physical experiments to an interpretable model of how operating conditions shape battery water loss.",
    sections: [
      { title: "The question", text: "How do charging voltage, temperature, and time affect water loss in lead-acid batteries? My undergraduate thesis investigated those relationships to support decisions about charging strategies and thermal management." },
      { title: "The approach", text: "I used controlled measurements from 18 batteries across a replicated three-by-three voltage–temperature design. The model combined an exponential degradation law with Arrhenius temperature dependence. Log transformations made the relationships suitable for regression-based parameter estimation." },
      { title: "The contribution", text: "I assessed fit through residual diagnostics, coefficient significance, normality checks, and R², then integrated the estimated relationships into a predictive calculator. The result connected operating conditions to remaining water and cumulative loss, with predictions interpreted within the model’s assumptions." },
    ],
    methods: "Experimental design · Regression · Degradation kinetics · Predictive modeling",
  },
];
---

<div class="research-gallery">
  {projects.map(project => (
    <details class="research-card" id={`research-${project.id}`}>
      <summary>
        <div class="research-thumbnail" aria-hidden="true">
          <svg viewBox="0 0 360 220" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs><pattern id={`research-grid-${project.id}`} width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="currentColor" opacity=".13" /></pattern></defs>
            <rect width="360" height="220" fill={`url(#research-grid-${project.id})`} />
            {project.id === "semantic" && <>
              <path d="M62 162 178 56 303 112 185 185Z" fill="var(--accent)" fill-opacity=".12" stroke="var(--accent)" />
              <path d="m61 163 230-26M98 186 240 49M181 185 178 56" stroke="currentColor" stroke-opacity=".3" />
              <path d="m115 119 34 22 43-42 33 28 38-29" stroke="currentColor" stroke-width="1.5" />
              {[ [115,119], [149,141], [192,99], [225,127], [263,98] ].map(([cx,cy]) => <circle cx={cx} cy={cy} r="5" fill="var(--accent)" stroke="var(--ink)" />)}
              <text x="23" y="28">POINTS / SUBSPACES / DIRECTIONS</text>
              <text x="23" y="204">REPRESENTATION STUDY</text>
            </>}
            {project.id === "compression" && <>
              <rect x="38" y="46" width="89" height="126" rx="4" fill="var(--bg)" stroke="currentColor" stroke-opacity=".5" />
              {[65,79,93,107,121,135,149].map(y => <path d={`M52 ${y}h61`} stroke="currentColor" stroke-opacity=".35" stroke-width="2" />)}
              <path d="M145 108h63m-8-8 8 8-8 8" stroke="currentColor" stroke-width="1.5" />
              <rect x="228" y="66" width="89" height="86" rx="4" fill="var(--bg)" stroke="var(--accent)" stroke-width="2" />
              {[86,101,116,131].map(y => <path d={`M242 ${y}h61`} stroke="var(--accent)" stroke-width="3" />)}
              <text x="23" y="28">SOURCE → LIMITED BUDGET</text>
              <text x="23" y="204">WHAT INFORMATION SURVIVES?</text>
            </>}
            {project.id === "thesis" && <>
              <path d="M49 45v128h265" stroke="currentColor" stroke-opacity=".5" />
              <path d="M58 61c52 13 64 67 126 88 35 12 77 14 120 16" stroke="var(--accent)" stroke-width="3" />
              <path d="M58 61c56 4 97 32 139 60 31 21 68 31 107 33" stroke="currentColor" stroke-opacity=".4" stroke-width="2" stroke-dasharray="5 6" />
              {[ [69,67], [99,87], [128,116], [162,139], [208,154], [258,162], [297,165] ].map(([cx,cy]) => <circle cx={cx} cy={cy} r="4" fill="var(--bg)" stroke="var(--ink)" stroke-width="1.5" />)}
              <text x="23" y="28">VOLTAGE / TEMPERATURE / TIME</text>
              <text x="23" y="204">DEGRADATION MODEL · SCHEMATIC</text>
            </>}
          </svg>
          <span class="thumbnail-label">{project.number} · Concept illustration</span>
        </div>
        <div class="research-card-copy">
          <p class="research-category">{project.category}</p>
          <h3>{project.title}</h3>
          <p class="research-status">{project.status}</p>
          <p class="research-summary">{project.summary}</p>
          <span class="research-toggle"><span class="when-closed">Explore the research</span><span class="when-open">Close research notes</span><span class="toggle-icon" aria-hidden="true">+</span></span>
        </div>
      </summary>
      <div class="research-disclosure">
        {project.sections.map(section => <section><h4>{section.title}</h4><p>{section.text}</p></section>)}
        <p class="research-methods">{project.methods}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .research-gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-16); align-items: start; padding: 0 clamp(var(--space-16), 3vw, var(--space-48)) var(--space-48); }
  .research-card { min-width: 0; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); overflow: clip; }
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline-offset: -4px; }
  .research-thumbnail { background: var(--surface); border-bottom: 1px solid var(--line); }
  svg { display: block; width: 100%; height: auto; color: var(--ink); }
  svg text { fill: var(--muted); font-family: var(--font-sans); font-size: 9px; letter-spacing: .8px; }
  .thumbnail-label { display: block; padding: 0 var(--space-16) var(--space-12); color: var(--muted); font-size: .7rem; }
  .research-card-copy { padding: var(--space-24); }
  .research-category { margin: 0 0 var(--space-12); color: var(--muted); font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  h3 { margin: 0; font-size: clamp(1.3rem, 2vw, 1.6rem); line-height: 1.18; font-weight: 650; letter-spacing: -.025em; }
  .research-status { margin: var(--space-12) 0 0; color: var(--muted); font-size: .75rem; line-height: 1.5; }
  .research-summary { margin: var(--space-16) 0 var(--space-24); color: var(--muted); font-size: .9rem; line-height: 1.7; }
  .research-toggle { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); color: var(--ink); font-size: .8rem; font-weight: 700; }
  .toggle-icon { display: grid; place-items: center; width: 28px; height: 28px; flex: none; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-size: 1.1rem; font-weight: 500; }
  summary:hover .research-toggle > span:first-child { text-decoration: underline; text-underline-offset: .25em; }
  .when-open { display: none; }
  details[open] .when-closed { display: none; }
  details[open] .when-open { display: inline; }
  details[open] .toggle-icon { transform: rotate(45deg); }
  .research-disclosure { margin: 0 var(--space-24); padding: var(--space-24) 0; border-top: 1px solid var(--line); }
  .research-disclosure section + section { margin-top: var(--space-24); }
  h4 { margin: 0 0 var(--space-8); font-size: .9rem; font-weight: 700; }
  .research-disclosure section p { margin: 0; color: var(--muted); font-size: .88rem; line-height: 1.8; }
  .research-methods { margin: var(--space-24) 0 0; padding-top: var(--space-16); border-top: 1px solid var(--line); color: var(--muted); font-size: .75rem; line-height: 1.7; }
  @media (max-width: 960px) { .research-gallery { grid-template-columns: 1fr; } summary { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); } .research-thumbnail { align-self: stretch; display: flex; flex-direction: column; justify-content: center; border-bottom: 0; border-right: 1px solid var(--line); } }
  @media (max-width: 560px) { summary { display: block; } .research-thumbnail { border-bottom: 1px solid var(--line); border-right: 0; } .research-card-copy { padding: var(--space-24); } }
</style>
