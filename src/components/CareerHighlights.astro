---
import type { CollectionEntry } from 'astro:content';
import { companyLogos, companyNames, companyHomepages } from '../data/projects';
import Arrow from './Arrow.astro';
interface Props {
  chapters: { study: CollectionEntry<'caseStudies'>; framing?: { skill: string; heading: string; narrative: string; evidence: string } }[];
}
const { chapters } = Astro.props;
---
<div class="career-highlights" data-career-tabs>
  <div class="career-panels">
    {chapters.map(({ study, framing }, index) => <article class="career-panel" id={`chapter-${study.id}`} aria-labelledby={`chapter-heading-${study.id}`}>
      <div class="chapter-copy">
        <p class="eyebrow">{study.data.role} · {study.data.timeframe}</p>
        <h3 id={`chapter-heading-${study.id}`}>{framing?.heading ?? study.data.title}</h3>
        <h4>The challenge</h4><p>{study.data.challenge}</p>
        <h4>My approach</h4><p>{framing?.narrative ?? study.data.summary}</p>
        <a class="text-link" href={`/stories/${study.id}/`}>Explore the project <Arrow /></a>
      </div>
      <div class="chapter-evidence">
        <div class="chapter-brand"><a href={companyHomepages[study.id]} target="_blank" rel="noopener noreferrer" aria-label={`${companyNames[study.id]} homepage (opens in a new tab)`}><img src={companyLogos[study.id]} alt={companyNames[study.id]} width="180" height="60" loading="lazy" /></a><span aria-hidden="true">0{index + 1}</span></div>
        <div><p class="eyebrow">What the work shows</p><p class="chapter-result">{framing?.evidence ?? study.data.outcome}</p></div>
        <ul class="chapter-capabilities">{study.data.capabilities.slice(0, 3).map(item => <li>{item}</li>)}</ul>
      </div>
    </article>)}
  </div>
  <div class="career-tabs" aria-label="Career highlights" hidden>
    {chapters.map(({ study, framing }, index) => <button type="button" id={`tab-${study.id}`} aria-controls={`chapter-${study.id}`}><span aria-hidden="true">0{index + 1}</span>{framing?.skill ?? study.data.eyebrow}</button>)}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-career-tabs]').forEach(root => {
    const tablist = root.querySelector<HTMLElement>('.career-tabs')!;
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('button'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.career-panel'));
    const activate = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
      if (focus) tabs[index].focus();
    };
    tablist.hidden = false;
    tablist.setAttribute('role', 'tablist');
    tabs.forEach((tab, index) => {
      tab.setAttribute('role', 'tab');
      panels[index].setAttribute('role', 'tabpanel');
      panels[index].setAttribute('aria-labelledby', tab.id);
      panels[index].tabIndex = 0;
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', event => {
        const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : event.key === 'ArrowLeft' ? (index - 1 + tabs.length) % tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : null;
        if (next !== null) { event.preventDefault(); activate(next, true); }
      });
    });
    const linkedChapter = panels.findIndex(panel => `#${panel.id}` === window.location.hash);
    activate(linkedChapter >= 0 ? linkedChapter : 0);
  });
</script>
<style>
  .career-panel { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(var(--space-32), 5vw, var(--space-64)); padding-block: var(--space-24) var(--space-48); }
  .career-panel[hidden], .career-tabs[hidden] { display: none; }
  .chapter-copy h3 { margin: var(--space-16) 0 var(--space-32); font-size: clamp(1.6rem, 2.5vw, 2.1rem); font-weight: 550; letter-spacing: -.03em; line-height: 1.2; }
  .chapter-copy h4 { margin: var(--space-24) 0 var(--space-8); font-size: .85rem; font-weight: 650; }
  .chapter-copy > p:not(.eyebrow) { margin: 0; color: var(--muted); font-size: .95rem; }
  .chapter-copy > .text-link { margin-top: var(--space-24); }
  .chapter-copy > .eyebrow { color: var(--muted); font-size: .65rem; }
  .chapter-evidence { display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-40); align-self: start; min-height: 370px; padding: clamp(var(--space-24), 3vw, var(--space-40)); border: 1px solid var(--line); border-radius: 8px; background: linear-gradient(145deg, var(--bg), var(--accent-tint)); box-shadow: 0 20px 40px -30px var(--shadow); }
  .chapter-brand { display: flex; justify-content: space-between; align-items: start; gap: var(--space-24); }
  .chapter-brand a { display: inline-block; }
  .chapter-brand img { width: 160px; height: 54px; object-fit: contain; object-position: left center; filter: grayscale(1); }
  .chapter-brand > span { color: var(--muted); font-size: .75rem; }
  .chapter-result { margin: var(--space-16) 0 0; font-size: clamp(1.35rem, 2vw, 1.7rem); line-height: 1.4; letter-spacing: -.025em; font-weight: 500; }
  .chapter-capabilities { display: flex; flex-wrap: wrap; gap: var(--space-8) var(--space-16); margin: 0; padding: var(--space-16) 0 0; border-top: 1px solid var(--line); list-style: none; color: var(--muted); font-size: .75rem; }
  .career-tabs { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid var(--line); }
  .career-tabs button { display: flex; flex-direction: column; align-items: start; gap: var(--space-12); padding: var(--space-24); border: 0; border-top: 2px solid transparent; background: transparent; color: var(--muted); text-align: left; font-size: .85rem; line-height: 1.5; }
  .career-tabs button + button { border-left: 1px solid var(--line); }
  .career-tabs button > span { font-size: .7rem; }
  .career-tabs button[aria-selected="true"] { border-top-color: var(--accent); background: var(--surface); color: var(--ink); }
  .career-tabs button:hover { background: var(--surface); }
  @media (max-width: 720px) {
    .career-panel { grid-template-columns: 1fr; }
    .chapter-evidence { min-height: 300px; }
    .career-tabs { grid-template-columns: repeat(2, 1fr); }
    .career-tabs button { padding: var(--space-16); }
    .career-tabs button:nth-child(3) { border-left: 0; }
    .career-tabs button:nth-child(n+3) { border-bottom: 1px solid var(--line); }
  }
</style>
