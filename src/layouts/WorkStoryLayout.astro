---
import BaseLayout from './BaseLayout.astro';
interface Props {
  title: string; summary: string; category: string; eyebrow: string; canonicalPath: string;
  resultHeading?: string; outcome: string; metricHeading?: string;
  metrics?: { value: string; label: string; note?: string }[];
}
const { title, summary, category, eyebrow, canonicalPath, resultHeading = 'Key results', outcome, metricHeading = 'Project facts', metrics = [] } = Astro.props;
---
<BaseLayout title={title} description={summary} canonicalPath={canonicalPath}>
  <article class="story-page shell">
    <nav class="story-breadcrumb" aria-label="Breadcrumb"><a href="/work/">Work</a><span aria-hidden="true">/</span><span>{category}</span></nav>
    <header class="story-intro">
      <div class="intro-copy"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="story-deck">{summary}</p></div>
      <aside class="story-context" aria-label="Project details"><slot name="context" /></aside>
    </header>
    <div class="story-body">
      <aside class="results-rail" aria-labelledby="results-title">
        <div class="results-sticky" tabindex="0" role="region" aria-labelledby="results-title">
          <h2 id="results-title">{resultHeading}</h2>
          <p class="result-outcome">{outcome}</p>
          {metrics.length > 0 && <div class="result-metrics"><h3>{metricHeading}</h3>{metrics.map(metric => <div class="result-item"><strong>{metric.value}</strong><span>{metric.label}</span>{metric.note && <small>{metric.note}</small>}</div>)}</div>}
        </div>
      </aside>
      <div class="article-copy"><slot /></div>
    </div>
    <nav class="story-related" aria-label="More work"><slot name="related" /></nav>
  </article>
</BaseLayout>
<style>
  .story-page { border-inline: 1px solid var(--line); padding-inline: var(--space-16); }
  .story-breadcrumb { display: flex; gap: var(--space-12); align-items: center; padding-block: var(--space-24); font-size: .9rem; font-weight: 600; }
  .story-breadcrumb a { color: var(--accent-link); text-decoration: none; }
  .story-breadcrumb a:hover { color: var(--link-hover); }
  .story-breadcrumb > span[aria-hidden] { color: var(--line); }
  .story-intro { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; align-items: start; gap: clamp(var(--space-32), 5vw, var(--space-64)); padding-block: var(--space-56) var(--space-80); }
  .intro-copy > .eyebrow { color: var(--accent-link); font-size: .75rem; }
  h1 { max-width: 24ch; margin: var(--space-16) 0 var(--space-24); font-size: var(--text-h1); font-weight: var(--weight-h1); line-height: 1.12; letter-spacing: -.035em; }
  .story-deck { max-width: 44rem; margin: 0; color: var(--muted); font-size: 1.08rem; line-height: 1.75; }
  .story-context { padding: var(--space-24); border: 1px solid var(--line); border-radius: 6px; background: var(--surface); }
  .story-context :global(.story-company) { display: block; width: fit-content; margin-bottom: var(--space-24); }
  .story-context :global(.story-company img) { width: 150px; height: 52px; object-fit: contain; object-position: left center; }
  .story-context :global(dl) { display: grid; gap: var(--space-16); margin: 0; }
  .story-context :global(dt), .story-context :global(h2) { margin: 0 0 var(--space-4); color: var(--muted); font-size: .75rem; font-weight: 500; }
  .story-context :global(dd) { margin: 0; font-size: .85rem; line-height: 1.6; }
  .story-context :global(.context-skills) { margin-top: var(--space-24); padding-top: var(--space-16); border-top: 1px solid var(--line); }
  .story-context :global(ul) { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-12); padding: 0; margin: var(--space-8) 0 0; list-style: none; }
  .story-context :global(li) { font-size: .75rem; line-height: 1.7; }
  .story-body { display: grid; grid-template-columns: 15rem minmax(0, 1fr); gap: clamp(var(--space-32), 5vw, var(--space-64)); padding-bottom: var(--space-64); }
  .results-rail { min-width: 0; }
  .results-sticky { position: sticky; top: var(--space-24); max-height: calc(100dvh - 3rem); overflow-y: auto; scrollbar-width: thin; padding: var(--space-4) var(--space-16) var(--space-16) 0; }
  .results-sticky:focus-visible { outline-offset: 3px; }
  .results-sticky h2 { margin: 0 0 var(--space-16); padding-left: var(--space-12); border-left: 2px solid var(--accent); font-size: 1.1rem; font-weight: 600; letter-spacing: -.02em; }
  .result-outcome { margin: 0; color: var(--muted); font-size: .88rem; line-height: 1.75; }
  .result-metrics { margin-top: var(--space-32); }
  .result-metrics h3 { margin: 0 0 var(--space-24); color: var(--muted); font-size: .75rem; font-weight: 600; }
  .result-item + .result-item { margin-top: var(--space-24); }
  .result-item strong, .result-item span, .result-item small { display: block; }
  .result-item strong { padding-left: var(--space-12); border-left: 2px solid var(--accent); font-size: 1.9rem; font-weight: 550; letter-spacing: -.03em; line-height: 1.15; }
  .result-item span { margin-top: var(--space-8); font-size: .85rem; font-weight: 600; }
  .result-item small { margin-top: var(--space-8); color: var(--muted); font-size: .75rem; line-height: 1.6; }
  .article-copy { min-width: 0; padding-right: var(--space-16); }
  .article-copy :global(h2) { margin: var(--space-40) 0 var(--space-16); font-size: clamp(1.4rem, 2.2vw, 1.8rem); font-weight: 550; letter-spacing: -.025em; line-height: 1.3; }
  .article-copy :global(h2:first-child) { margin-top: 0; }
  .article-copy :global(p), .article-copy :global(li) { color: var(--muted); font-size: 1rem; line-height: 1.85; }
  .article-copy :global(p) { margin: 0 0 var(--space-16); }
  .article-copy :global(a) { color: var(--accent-link); text-underline-offset: .2em; }
  .article-copy :global(a:hover) { color: var(--link-hover); }
  .article-copy :global(ul), .article-copy :global(ol) { padding-left: var(--space-24); }
  .article-copy :global(strong) { color: var(--ink); font-weight: 600; }
  .article-copy :global(figure) { margin: var(--space-32) 0; padding: var(--space-16); border: 1px solid var(--line); border-radius: 4px; background: var(--bg); }
  .article-copy :global(figure img) { width: 100%; height: auto; }
  .article-copy :global(figcaption) { margin-top: var(--space-16); color: var(--muted); font-size: .8rem; line-height: 1.75; }
  .article-copy :global(table) { width: 100%; table-layout: fixed; margin: var(--space-24) 0; border-collapse: collapse; font-size: .85rem; line-height: 1.6; }
  .article-copy :global(th), .article-copy :global(td) { padding: var(--space-12) var(--space-8); border-bottom: 1px solid var(--line); vertical-align: top; overflow-wrap: break-word; }
  .article-copy :global(th) { font-size: .8rem; font-weight: 600; color: var(--ink); }
  .article-copy :global(td) { color: var(--muted); font-variant-numeric: tabular-nums; }
  .article-copy :global(.story-challenge) { margin-bottom: var(--space-40); }
  .article-copy :global(.story-notes) { margin-top: var(--space-40); border-block: 1px solid var(--line); padding-block: var(--space-16); }
  .article-copy :global(summary) { cursor: pointer; font-size: .9rem; font-weight: 600; }
  .article-copy :global(.story-notes[open] summary) { margin-bottom: var(--space-24); }
  .article-copy :global(.story-notes li), .article-copy :global(.story-notes p) { font-size: .9rem; }
  .article-copy :global(.workflow) { margin-block: var(--space-24); padding: var(--space-24); }
  .article-copy :global(.workflow li) { padding: var(--space-16); }
  .story-related { display: grid; gap: var(--space-16); padding-block: var(--space-32) var(--space-64); border-top: 1px solid var(--line); }
  .story-related :global(h2) { margin: 0; font-size: 1.1rem; font-weight: 550; }
  .story-related :global(a) { width: fit-content; }
  @media (max-width: 900px) {
    .story-intro { grid-template-columns: 1fr; gap: var(--space-32); padding-block: var(--space-32) var(--space-48); }
    h1 { max-width: 26ch; }
    .story-context :global(dl) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .story-body { grid-template-columns: 1fr; gap: var(--space-40); }
    .results-sticky { position: static; max-height: none; overflow: visible; padding: 0 0 var(--space-32); border-bottom: 1px solid var(--line); }
    .result-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-24); }
    .result-metrics h3 { grid-column: 1 / -1; margin: 0; }
    .result-item + .result-item { margin-top: 0; }
    .article-copy { padding-right: 0; }
  }
  @media (max-width: 480px) {
    .story-context :global(dl), .result-metrics { grid-template-columns: 1fr; }
    .article-copy :global(th), .article-copy :global(td) { padding-inline: var(--space-4); }
    .article-copy :global(figure) { padding: var(--space-8); }
  }
</style>
